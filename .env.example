# OpenWebUI-Kubernetes — site configuration template
#
# Copy this file to .env in the repository root and fill in real values:
#
#     cp .env.example .env
#     chmod 600 .env
#     $EDITOR .env
#
# ./deploy/setup.sh does all of that and reports every key still missing.
#
# .env holds SITE VALUES ONLY — a node name, a URL, host paths, capacity
# numbers, the Postgres coordinates. It carries NO credential. Every secret
# (database password, session signing key, Google OAuth pair, Brave Search
# key) lives in pre-created Kubernetes Secrets, encrypted at rest by K3s
# --secrets-encryption, and is entered once through:
#
#     ./deploy/secret-init.sh
#
# All three deploy.sh scripts — deploy/deploy.sh and the two component
# scripts — read .env, and none of them will run without it.
#
# The SITE values below are not secret. They are here because they identify
# one particular installation — a hostname, a node name, an internal address —
# and a repository meant to be cloned and shared must not carry them.
#
# Never commit .env. Never paste site values into a values.yaml or a commit
# message.
#
# Format is strict KEY=VALUE, one per line. No quotes, no spaces around '=',
# no `export` prefix, no trailing comments — the deploy scripts parse it literally.

# ── Site ──────────────────────────────────────────────────────────────────────
# Consumed by both component scripts.

# The name the K3s node registered under: the output of `kubectl get nodes`, which
# is the kubernetes.io/hostname label. It is not necessarily what `hostname`
# prints on the box. Every local PV pins nodeAffinity to it, so a wrong value
# leaves PVCs stuck in Pending with events that do not mention the mismatch.
# ./deploy/setup.sh fills this in from the cluster when it can reach one.
K3S_NODE_NAME=CHANGE-ME-output-of-kubectl-get-nodes

# The URL people reach the app at. With Google SSO it must be the https:// URL
# of your reverse proxy, no trailing slash; without SSO it can be
# http://<node-ip>:30000 and no proxy is needed. It is passed to the container
# as WEBUI_URL and used to build OAuth and email links, so when SSO is on the
# OAuth provider must have exactly this value plus /oauth/google/ registered as
# an authorised redirect URI. A missing scheme is rejected at deploy time; the
# cookie flags deploy.sh renders follow this value's scheme (https -> Secure
# cookies, http -> plain).
# Replace the whole line; a host that resolves nowhere produces a login that fails
# with an opaque provider error.
WEBUI_URL=CHANGE-ME-https://ai.example.com

# Base URL of an OpenAI-compatible inference endpoint, path included. Point it at
# llama.cpp, vLLM, Ollama's OpenAI-compatible route, or a hosted provider.
#
# This is what the chart writes on first start. Once the admin has saved endpoint
# settings in the Open WebUI admin UI, the app's own `config` table row wins
# (ENABLE_PERSISTENT_CONFIG is "true") — read it with:
#     select value from config where key = 'openai.api_base_urls'
OPENAI_API_BASE_URL=CHANGE-ME-http://inference.example.net:8080/v1

# The two data roots. Everything the stack writes to disk lives under one of them.
# LEAVE BOTH EMPTY to use the defaults:
#     LIVE_DATA_PATH   -> ~/.open-webui/live-data
#     BACKUP_DATA_PATH -> ~/.open-webui/backup-data
# Set them to a path to override (e.g. a mounted disk: /mnt/apps_ssd). The deploy
# scripts create the subdirectories and inject the full paths into the charts, so
# you never edit values.yaml. The layout under each root is fixed:
#     <LIVE_DATA_PATH>/postgresql           Postgres data (the database itself)
#     <LIVE_DATA_PATH>/postgresql-backups   first-copy pg_dump archives
#     <LIVE_DATA_PATH>/searxng              SearXNG config and state
#     <LIVE_DATA_PATH>/open-webui           uploads, vector_db, cache
#     <BACKUP_DATA_PATH>/postgresql         second-copy database dumps
#     <BACKUP_DATA_PATH>/open-webui         second-copy volume archives
# Ownership: setup.sh creates these directories owned by the user who runs it (and
# refuses to run as root), and the app and backup pods run as that same user, so the
# tree stays user-owned end to end. Never run setup.sh with sudo.
# Production recommendation (advisory, not enforced): put the two roots on
# different physical devices, or make the backup root a remote mount. One disk
# holding both the data and its only backup dies together. Changing a root after
# the first deploy means moving the data and recreating the local PVs, whose
# paths are immutable.
LIVE_DATA_PATH=
BACKUP_DATA_PATH=

# ── Capacity and scale ────────────────────────────────────────────────────────
# Consumed by BOTH component scripts. Together these four keys decide every CPU
# and memory limit in the stack, so the numbers can never disagree with each
# other or with the database tuning.
#
# MESSAGE_SCALE is what you are sizing FOR, in total stored chat messages. It
# selects a coherent resource envelope; the deploy scripts refuse a scale the
# declared CPU, RAM or disk cannot carry, and tell you the number they need.
#     small   100,000 messages   ~2 GB database    4 cores   8 GB RAM    50 GB disk
#     medium  1,000,000          ~20 GB            8 cores  16 GB RAM   250 GB disk
#     large   10,000,000         ~200 GB          12 cores  24 GB RAM  1500 GB disk
#
# The database estimate is measured, not guessed: one stored message costs about
# 20 kB once the chat JSON copy, the message row and their indexes are counted.
# Documents do not go in Postgres — they go to the open-webui volume — so chat
# text is what drives growth.
#
# Disk is the constraint that bites first at the high end. The Postgres backup
# job keeps 7 daily dumps and a compressed dump runs about a third of the
# database, so `large` needs ~200 GB database + ~20 GB WAL + ~450 GB of dumps
# before the uploads volume is counted. If the declared disk cannot hold the
# scale, the deploy stops and says so instead of filling the volume later.
#
# Raising MESSAGE_SCALE also raises UVICORN_WORKERS, shared_buffers,
# effective_cache_size and max_connections together — that is what keeps
# response time flat as the database grows. Do not hand-edit those in
# values.yaml; they are rendered from this profile.
MESSAGE_SCALE=small

# What this machine can actually spare for the stack. The wizard suggests the
# detected values; lower them only if this node also runs other workloads. These
# are gates, not allocations: choosing a scale that needs more than this fails
# the deploy with the exact shortfall.
DEPLOY_CPU_CORES=4
DEPLOY_MEMORY_GB=8
DEPLOY_STORAGE_GB=50

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Consumed by deploy/postgresql/deploy.sh (helm release `postgres`). These are
# coordinates, not credentials: the database password lives in the pre-created
# `postgres` Secret (deploy/secret-init.sh) and never in this file.

POSTGRES_HOST=postgres.default.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui

# ── Credentials (NOT here) ────────────────────────────────────────────────────
# Every credential is entered once, interactively, through ./deploy/secret-init.sh
# and stored in the K3s datastore — never in this file:
#
#   postgres password            -> Secret `postgres`, key `password`
#   session signing key          -> Secret `ai-open-webui-secrets`, key WEBUI_SECRET_KEY
#   DATABASE_URL                 -> Secret `ai-open-webui-secrets`, key DATABASE_URL
#                                   (assembled by secret-init.sh from the POSTGRES_*
#                                   values above plus the password you type, so the
#                                   DSN and the password can never drift apart)
#   Google OAuth pair (optional) -> Secret `ai-open-webui-secrets`, keys
#                                   GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
#                                   (both or neither; from
#                                   https://console.cloud.google.com/apis/credentials;
#                                   both set = Google sign-in with the login form
#                                   disabled, both empty = the built-in login form)
#   Brave Search key (optional)  -> Secret `ai-open-webui-searxng`, key
#                                   `brave-api-key` (https://brave.com/search/api/)
#
# Rotate the database password with ALTER USER in psql FIRST, then re-run
# secret-init.sh, then restart the app — the same order the old .env flow
# required. Verify at any time with ./deploy/secret-init.sh --check.
